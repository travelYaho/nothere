VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8000

# 카카오 로그인 후 앱이 받는 콜백. 비우거나 잘못된 값이면
# 현재 origin + /auth/callback 을 쓴다. 배포 시에도 이 경로가
# Supabase Authentication > URL Configuration > Redirect URLs 에 있어야 한다.
# Kakao Developers 의 Redirect URI 는 이 값이 아니라
# https://<프로젝트-ref>.supabase.co/auth/v1/callback 이다.
VITE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
