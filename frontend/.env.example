VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8000

# 카카오 로그인 후 앱이 받는 콜백. Supabase Authentication > URL Configuration 의
# Redirect URLs 와 같아야 한다. Kakao Developers 의 Redirect URI 는 이 값이 아니라
# https://<프로젝트-ref>.supabase.co/auth/v1/callback 이다.
# Kakao REST API Key / Client Secret 은 코드가 아니라
# Supabase Dashboard > Authentication > Providers > Kakao 에 넣는다.
VITE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
